generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model About {
  id        String   @id
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Curriculum {
  id          String   @id
  department  String
  year        String
  createdAt   DateTime @default(now())
  description String
  name        String
}

model Gallery {
  id        String   @id
  imageUrl  String
  caption   String
  createdAt DateTime @default(now())
}

model Lounge {
  id          String   @id
  name        String
  description String
  imageUrl    String?
  averageTemp Float?
  capacity    Int?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model News {
  id        String   @id
  title     String
  content   String
  published Boolean  @default(true)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Schedule {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime
  day       String
  time      String
  food      String
}
